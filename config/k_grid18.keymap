#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <34 33>;
        };

        kanaE {
            bindings = <&kp LG(SPACE)>;
            key-positions = <32 31>;
        };

        CC {
            bindings = <&kp LC(SPACE)>;
            key-positions = <4 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q  &kp L  &kp E           &kp U  &kp COMMA       &kp H      &kp T      &kp S                &kp Y  &kp B
&kp Z  &kp J  &kp I           &kp A  &kp O           &kp K      &kp N      &kp R                &kp D  &kp P
&mo 2  &kp X  &kp C           &kp V  &kp DOT         &kp G      &kp M      &kp MINUS            &kp W  &kp F
              &kp LEFT_SHIFT  &mo 1  &kp LC(LSHIFT)  &kp SPACE  &kp ENTER  &mt LCTRL BACKSPACE
            >;
        };

        layer_1 {
            display-name = "Edit";
            bindings = <
&none   &none    &kp LS(LBKT)          &kp LS(RBKT)           &kp ESC             &kp AT     &kp N7  &kp N8  &kp N9  &none
&kp F7  &kp F10  &kp LBKT              &kp RIGHT_BRACKET      &kp SLASH           &kp EQUAL  &kp N4  &kp N5  &kp N6  &none
&none   &none    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LC(LEFT_SHIFT)  &kp N0     &kp N1  &kp N2  &kp N3  &kp TAB
                 &none                 &none                  &none               &none      &none   &none
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &none  &bootloader     &msc SCRL_UP    &none         &mkp RCLK        &mmv MOVE_UP    &mkp LCLK
&none       &bt BT_SEL 2  &none         &none  &bt BT_CLR_ALL  &msc SCRL_DOWN  &kp UP_ARROW  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&none       &bootloader   &none         &none  &none           &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &none           &none
                          &none         &none  &none           &none           &none         &none
            >;
        };
    };
};
