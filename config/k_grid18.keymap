#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        WKanaE {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <34 33>;
        };

        kanaE {
            bindings = <&kp LG(SPACE)>;
            key-positions = <32 31>;
        };

        ss {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <4 3>;
        };

        Wss {
            bindings = <&kp LS(LG(S))>;
            key-positions = <5 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q           &kp L  &kp E  &kp U     &kp COMMA         &kp H           &kp T      &kp S          &kp Y      &kp B
&kp Z           &kp J  &kp I  &kp A     &kp O             &kp K           &kp N      &kp R          &kp D      &kp P
&kp LEFT_SHIFT  &kp X  &kp C  &kp V     &mt LCTRL PERIOD  &mt LEFT_ALT G  &kp M      &kp W          &kp MINUS  &kp F
                       &mo 1  &kp LGUI  &kp LC(LSHIFT)    &kp SPACE       &kp ENTER  &kp BACKSPACE
            >;
        };

        layer_1 {
            display-name = "Edit";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_CLR_ALL         &kp HASH        &kp AT        &kp N7          &kp N8          &kp N9  &msc SCRL_UP
&kp F7          &kp F10       &kp LBKT              &kp RIGHT_BRACKET      &kp LS(LBKT)    &kp LS(RBKT)  &kp N4          &kp N5          &kp N6  &msc SCRL_DOWN
&kp LEFT_SHIFT  &none         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none           &kp NUMBER_0  &kp N1          &kp N2          &kp N3  &mkp LCLK
                              &none                 &none                  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_LEFT
            >;
        };
    };
};
