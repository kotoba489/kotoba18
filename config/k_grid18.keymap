#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <34 33>;
        };

        kanaE {
            bindings = <&kp LC(SPACE)>;
            key-positions = <32 31>;
        };

        ss {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <3 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q    &kp D  &kp E           &kp U      &kp COMMA  &kp H      &kp S      &kp Y      &kp R  &kp B
&lt 2 Z  &kp J  &kp I           &kp A      &kp O      &kp K      &kp N      &kp T      &kp W  &kp P
&mo 1    &kp X  &kp C           &kp V      &kp DOT    &kp G      &kp M      &kp F      &kp L  &kp MINUS
                &kp LEFT_SHIFT  &kp LA(D)  &kp LGUI   &kp SPACE  &kp ENTER  &kp LCTRL
            >;
        };

        layer_1 {
            display-name = "Edit";
            bindings = <
&kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LBKT        &kp RBKT     &kp ESC        &kp TAB    &kp N7     &kp N8     &kp N9  &kp N0
&none                 &none                  &kp LPAR        &kp RPAR     &kp SLASH      &kp EQUAL  &kp N4     &kp N5     &kp N6  &kp AT
&none                 &none                  &none           &kp PERCENT  &kp LC(SPACE)  &kp MINUS  &kp N1     &kp N2     &kp N3  &kp PERIOD
                                             &kp LEFT_SHIFT  &kp LC(D)    &kp LGUI       &kp SPACE  &kp ENTER  &kp LCTRL
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &none  &none  &none           &none  &none           &none           &none
&none           &bt BT_SEL 2  &bt BT_SEL 3  &none  &none  &msc SCRL_UP    &none  &mkp RCLK       &mmv MOVE_UP    &mkp LCLK
&none           &none         &none         &none  &none  &msc SCRL_DOWN  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                              &none         &none  &none  &none           &none  &none
            >;
        };
    };
};
