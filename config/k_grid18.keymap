#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <34 33>;
        };

        kanaE {
            bindings = <&kp LC(SPACE)>;
            key-positions = <32 31>;
        };

        ss {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <3 4>;
        };

        c+a {
            bindings = <&kp LC(A)>;
            key-positions = <5 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q           &kp D  &kp E      &kp U        &kp COMMA    &kp H      &kp S      &kp Y                    &kp R  &kp B
&kp Z           &kp J  &kp I      &kp A        &kp O        &kp K      &kp N      &kp T                    &kp W  &kp P
&kp LEFT_SHIFT  &kp X  &kp C      &kp V        &kp DOT      &kp G      &kp M      &kp F                    &kp L  &kp MINUS
                       &kp LCTRL  &lt 2 LC(D)  &lt 1 SPACE  &kp SPACE  &kp ENTER  &mt RIGHT_ALT BACKSPACE
            >;
        };

        layer_1 {
            display-name = "Edit";
            bindings = <
&kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LBKT  &kp RBKT     &kp ESC        &kp TAB    &kp N7  &kp N8     &kp N9  &kp N0
&none                 &none                  &kp LPAR  &kp RPAR     &kp SLASH      &kp EQUAL  &kp N4  &kp N5     &kp N6  &kp AT
&kp LEFT_SHIFT        &none                  &none     &kp PERCENT  &kp LC(SPACE)  &kp MINUS  &kp N1  &kp N2     &kp N3  &kp PERIOD
                                             &none     &none        &none          &none      &none   &kp LCTRL
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_DISC 0  &bt BT_DISC 1   &msc SCRL_UP    &none  &mkp RCLK        &mmv MOVE_UP    &mkp LCLK
&none       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_DISC 2  &bt BT_DISC 3   &msc SCRL_DOWN  &none  &mmv MOVE_RIGHT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&none       &none         &none         &none          &bt BT_CLR_ALL  &none           &none  &none            &none           &none
                          &none         &none          &none           &none           &none  &none
            >;
        };
    };
};
